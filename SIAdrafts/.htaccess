# Session cookie hardening lives in .user.ini, not here: MAMP (and most
# shared/FastCGI hosts) run PHP via mod_fastcgi rather than mod_php, and
# php_flag/php_value are only valid under mod_php — under FastCGI they
# make Apache treat the whole .htaccess as invalid and 500 every request.
# See SIAdrafts/.user.ini for the actual session.* directives.
#
# 2026-09-11: confirmed on this local XAMPP install that .user.ini is not
# actually being read at all under this Apache/PHP build (apache2handler
# SAPI) — not even a same-directory .user.ini with one directive took
# effect; verified via ini_get() in a throwaway diagnostic script. Since
# THIS host runs PHP as the mod_php Apache module (see LoadModule
# php_module in httpd-xampp.conf), not FastCGI, the block below sets the
# same settings via php_flag/php_value, guarded by <IfModule php_module>
# so it's skipped cleanly (no 500) on a host where mod_php isn't loaded —
# giving working protection here without touching the .user.ini path for
# whatever the actual FastCGI/PHP-FPM production host turns out to be.
<IfModule php_module>
    php_flag session.cookie_httponly on
    php_flag session.use_strict_mode on
    php_value session.cookie_samesite "Lax"
    php_value session.gc_maxlifetime 1800
    php_flag display_errors off
    php_flag log_errors on
</IfModule>

# A hardcoded auto_prepend_file path used to live in the block above —
# removed. It pointed at one collaborator's local Windows/XAMPP folder
# layout (C:/xampp/htdocs/...), which is exactly how the whole site went
# down once before (see git history, 2026-09-14) when that same mistake
# was in .user.ini instead. .htaccess/.user.ini are committed files
# shared across machines with different OSes and folder layouts, so
# nothing in them can be an absolute filesystem path — there's no path
# that's simultaneously correct on a Mac, this Windows machine, and
# whatever the real production host turns out to be.
# The thing that line was for (turning session.cookie_secure on once
# actually served over HTTPS) doesn't need a filesystem path at all: it's
# Backend/env_security.php's apply_https_cookie_security() function,
# called directly from Backend/config.php — a plain PHP function call,
# identical behavior on every machine, nothing to hardcode.

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Backstop for the app's own XSS escaping, not a replacement for it.
    # script-src/style-src need 'unsafe-inline' because the app has no
    # build step: every view mixes plain <script> blocks, onclick=
    # attributes, and inline style= into the HTML it renders, so a strict
    # nonce/hash policy would break every page today. What this still
    # buys us with no app changes: no script/object/frame/font/image can
    # load from a domain outside this allowlist, no <base> tag hijack
    # (base-uri), no data can be sent off-origin via fetch/XHR/WebSocket
    # (connect-src), no form can submit to a foreign host (form-action),
    # no plugin content (object-src), and framing is restricted twice
    # over (frame-ancestors here, X-Frame-Options above). Revisit
    # 'unsafe-inline' if inline scripts/handlers are ever moved to
    # external files with a per-request nonce.
    #
    # connect-src needs Iconify's icon-data API domains: the
    # <iconify-icon> web component loads its own JS fine under script-src,
    # but then fetches each icon's actual SVG data at runtime from
    # api.iconify.design (falling back to api.simplesvg.com/api.unisvg.com
    # if that's unreachable) — without these, that fetch is silently
    # blocked and every icon on the page renders as nothing.
    # font-src needs cdn.jsdelivr.net too, not just fonts.gstatic.com --
    # Bootstrap Icons' CSS (loaded from jsdelivr under style-src) declares
    # its actual glyphs via @font-face pointing at a .woff2 also served
    # from jsdelivr; without it here, that font file request is silently
    # blocked and every "bi bi-*" icon renders as an empty box (the mdi/
    # iconify icons are unaffected -- those fetch SVG data over connect-src
    # via api.iconify.design, not a font file).
    #
    # script-src/frame-src also allow www.google.com + www.gstatic.com for
    # reCAPTCHA on the public online-admission form (Backend/recaptcha.php) --
    # the widget's own JS loads under script-src, but it then renders its
    # actual checkbox/challenge UI in a cross-origin iframe, which needs an
    # explicit frame-src entry (no frame-src directive existed before this,
    # so it fell back to default-src 'self' and silently blocked the iframe).
    # frame-ancestors below is unrelated and unaffected -- that's who may
    # frame THIS site, not what this site may itself embed.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://code.jquery.com https://cdn.datatables.net https://code.iconify.design https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdn.datatables.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data:; connect-src 'self' https://api.iconify.design https://api.simplesvg.com https://api.unisvg.com; frame-src https://www.google.com/recaptcha/; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"

    # mod_ssl sets the "HTTPS" server/env variable itself whenever a
    # connection actually terminated TLS here — env=HTTPS makes this
    # header conditional on that, so it only ever gets sent once this is
    # really served over HTTPS, and is silently absent on today's plain
    # HTTP localhost (sending HSTS over plain HTTP has no effect per spec
    # anyway, but keeping it conditional avoids a false signal in dev).
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# .env, .env.example, .user.ini, .git, etc. are readable server-side but
# must never be served over HTTP — they were previously fetchable directly
# by URL (e.g. /SIAdrafts/.env) since nothing here denied dotfiles.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Directory listing was on (MAMP's default) — any folder with no index.php
# (Frontend/View/Admission/, Backend/api/Treasury/, etc.) served a raw file
# listing to anyone who requested the bare folder URL, no login required.
# That happens at the web-server level before any PHP (and therefore any
# require_role()/require_professor() check) ever runs. Applies recursively
# to every subfolder from here down — one line covers the whole app.
Options -Indexes

# Clean URLs for Frontend/View/** pages only — these are the ones that
# actually show up in the address bar. Backend/api/** and Backend/admin/**
# stay untouched: nothing links to them directly, several are POST form/
# fetch() targets, and a redirect there would risk being lossy for no
# visible benefit (they never appear in a browser's address bar).
#
# No code changes needed elsewhere: every existing link/redirect still
# points at *.php and keeps working — rule 1 just canonicalizes the
# address bar to the clean URL after the fact.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /SIAdrafts/

    # 1) A direct GET request for .../Frontend/View/something.php redirects
    #    (301) to the extension-less URL. Matched against THE_REQUEST (the
    #    client's original raw request line) rather than the current URI —
    #    rule 2 below rewrites internally to *.php, which re-triggers this
    #    whole ruleset from the top, and matching the current URI here
    #    would then catch that internal rewrite and redirect it right back
    #    to itself. THE_REQUEST is immune to internal rewrites, so this
    #    only fires for what the browser actually asked for. GET-only so
    #    POST bodies are never silently dropped by a redirect.
    #
    #    Built as a FULLY absolute https://%{HTTP_HOST}/... or
    #    http://%{HTTP_HOST}/... URL ourselves, deliberately -- a relative
    #    target (just the path) makes Apache auto-absolutize the Location
    #    header using its OWN view of scheme and port, which behind a
    #    TLS-terminating reverse proxy (Railway, and most real hosts) is
    #    plain HTTP on the proxy's internal port, not the public HTTPS URL
    #    the browser actually used -- confirmed live: this produced
    #    redirects to `http://host:8080/...`, broken for every external
    #    visitor. %{HTTP_HOST} is always the original public Host header
    #    regardless of proxying, so it never carries an internal port.
    #
    #    Condition is %{ENV:RW_HTTPS}, not the built-in %{HTTPS} -- that
    #    special mod_rewrite variable only ever reflects mod_ssl's own
    #    real-TLS-handshake state and ignores the generic HTTPS env var
    #    entirely, so behind a proxy (which never performs a TLS handshake
    #    with Apache itself) it's always "off" regardless of what any
    #    SetEnvIf sets -- confirmed live, this read as !=on even with
    #    HTTPS=on correctly set and the HSTS header correctly appearing
    #    from that same variable elsewhere. RW_HTTPS is a distinctly-named
    #    env var set alongside HTTPS in the Railway Docker image's own
    #    Apache conf (never in this portable .htaccess) specifically so
    #    this condition can read it via the generic %{ENV:...} syntax.
    RewriteCond %{THE_REQUEST} ^GET\s+/SIAdrafts/Frontend/View/([^?\s]+)\.php[?\s]
    RewriteCond %{ENV:RW_HTTPS} =on
    RewriteRule ^ https://%{HTTP_HOST}/SIAdrafts/Frontend/View/%1 [R=301,L]

    RewriteCond %{THE_REQUEST} ^GET\s+/SIAdrafts/Frontend/View/([^?\s]+)\.php[?\s]
    RewriteCond %{ENV:RW_HTTPS} !=on
    RewriteRule ^ http://%{HTTP_HOST}/SIAdrafts/Frontend/View/%1 [R=301,L]

    # 2) Internally serve the matching .php file for the extension-less
    #    URL, without changing what the browser shows.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^Frontend/View/(.+)$ Frontend/View/$1.php [L]

    # 3) Bare-folder requests (…/Admission/, …/Backend/api/Treasury/, etc.)
    #    are rewritten internally (no external redirect, so the address bar
    #    never changes) to a script that answers 204 No Content. Per the
    #    HTML spec, a top-level navigation that gets a 204 is discarded —
    #    the browser doesn't navigate away at all, whatever page was
    #    already open just stays open. Stronger than the old 403 (which
    #    still confirmed "a real folder exists here"): this shows nothing,
    #    says nothing, and the URL you typed never even takes effect.
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ /SIAdrafts/Backend/no_index.php [L]
</IfModule>
