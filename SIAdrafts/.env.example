DB_HOST=localhost
DB_PORT=8889
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=sia_final_db

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your_brevo_smtp_login
SMTP_PASSWORD=your_brevo_smtp_key
SMTP_FROM_EMAIL=your_verified_sender@example.com
SMTP_FROM_NAME=EduSchool

CSRF_SECRET=change_me_to_a_random_32_char_string

PAYMONGO_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
PAYMONGO_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# reCAPTCHA v2 ("I'm not a robot" checkbox) on the public online admission
# form. Register this site's domain at https://www.google.com/recaptcha/admin
# to get a real key pair -- the site key is safe to expose (it's rendered
# into the page), the secret key is not. Leaving RECAPTCHA_SITE_KEY unset
# hides the widget entirely and the backend fails closed (rejects every
# submission) rather than silently skipping verification.
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
