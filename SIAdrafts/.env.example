DB_HOST=localhost
DB_PORT=8889
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=sia_final_db

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your_brevo_smtp_login
SMTP_PASSWORD=your_brevo_smtp_key
SMTP_FROM_EMAIL=your_verified_sender@example.com
SMTP_FROM_NAME=EduSchool

# Preferred transport for outgoing mail (Backend/mailer.php) -- Brevo's
# HTTPS REST API, not SMTP. Many PaaS hosts (confirmed on Railway) block
# outbound SMTP ports entirely as a standard anti-abuse policy, which
# makes the SMTP path above hang for minutes per send instead of failing
# fast. Get this from Brevo's dashboard under SMTP & API > API Keys --
# it's a different credential from SMTP_USERNAME/SMTP_PASSWORD above.
# Leaving it unset falls back to the SMTP path automatically (fine for
# local dev, where SMTP ports usually aren't blocked).
BREVO_API_KEY=your_brevo_api_v3_key

CSRF_SECRET=change_me_to_a_random_32_char_string

PAYMONGO_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
PAYMONGO_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# reCAPTCHA v2 ("I'm not a robot" checkbox) on the public online admission
# form. Register this site's domain at https://www.google.com/recaptcha/admin
# to get a real key pair -- the site key is safe to expose (it's rendered
# into the page), the secret key is not. Leaving RECAPTCHA_SITE_KEY unset
# hides the widget entirely and the backend fails closed (rejects every
# submission) rather than silently skipping verification.
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
